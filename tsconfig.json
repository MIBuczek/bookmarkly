{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "customConditions": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "react-native-toast-notifications": [
        "./node_modules/react-native-toast-notifications/lib/typescript/index.d.ts"
      ],
      "react-native-toast-notifications/src/toast": [
        "./node_modules/react-native-toast-notifications/lib/typescript/toast.d.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    ".expo",
    "ios",
    "android",
    "dist"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
